# sudo rules for opsmcp: an example. It does nothing where it is. sudo reads rules from
# /etc/sudoers.d, and opsmcp's packages never put a file there: that step is yours. Set
# the group below, then, in this file's directory:
#
#     visudo -cf sudoers.example        # check it first: a broken rule file breaks sudo
#     install -o root -g root -m 0440 sudoers.example /etc/sudoers.d/opsmcp
#
# Change it afterwards with: visudo -f /etc/sudoers.d/opsmcp
#
# Lets members of group "ops" start the stdio server as root, and nothing else. sudo
# matches the command and its arguments exactly, so `opsmcp serve --config /tmp/mine`
# is not allowed by this rule; the configuration is always /etc/opsmcp/config.toml.
#
# opsmcp sees who invoked sudo (SUDO_UID) and applies that user's roles. Being able to
# start it grants nothing by itself: a user with no role is turned away.

%ops ALL=(root) NOPASSWD: /usr/bin/opsmcp serve

# On a bastion that runs a fleet server with keys only root can read (rules with
# identity = "fleet" in /etc/opsmcp/fleet.toml): let them start it, and nothing else.
# opsmcp applies the roles of the user who invoked sudo there too. Under sudo, rules that
# reuse the caller's own SSH identity never apply: the process is root, not the caller.
#
# %ops ALL=(root) NOPASSWD: /usr/bin/opsmcp fleet

# With `--read-only`, each form is its own exact command line and needs its own line:
#
# %ops ALL=(root) NOPASSWD: /usr/bin/opsmcp serve --read-only
